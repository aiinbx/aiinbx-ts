{
  "name": "aiinbx",
  "version": "4.5.1",
  "description": "Official TypeScript SDK for the AI Inbx API",
  "homepage": "https://aiinbx.com",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "aiinbx-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webhooks": {
      "aiinbx-source": "./src/webhooks.ts",
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "bun run test && bun run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "aiinbx",
    "email",
    "email-api",
    "send-email",
    "inbound-email",
    "email-threads",
    "email-webhooks",
    "ai-agents",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aiinbx/aiinbx-ts.git"
  },
  "bugs": "https://github.com/aiinbx/aiinbx-ts/issues",
  "peerDependencies": {
    "@react-email/render": "*"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-email/render": "^2.1.0",
    "@types/react": "^19",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6"
  }
}
